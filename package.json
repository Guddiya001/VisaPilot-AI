{
  "name": "visapilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "VisaPilot AI - AI-Powered International Job Search Platform",
  "scripts": {
    "dev": "turbo dev --concurrency=14",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @visapilot/database db:generate",
    "db:push": "pnpm --filter @visapilot/database db:push",
    "db:migrate": "pnpm --filter @visapilot/database db:migrate",
    "db:seed": "pnpm --filter @visapilot/database db:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
